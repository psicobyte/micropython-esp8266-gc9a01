# ESP Round LCD (IOTMCU "ESP Round LCD v1.0"): ESP-12S (4 MiB) + GC9A01 240x240
# Based on ESP8266_GENERIC (default variant, >= 2 MiB flash).

# Linker script generated by build.sh from upstream: same as esp8266_2MiB.ld
# but places the gc9a01 driver in irom0 (flash) instead of IRAM.
LD_FILES = $(BOARD_DIR)/gen/esp_round_lcd.ld

MICROPY_PY_ESPNOW ?= 1
MICROPY_PY_BTREE ?= 1
MICROPY_VFS_FAT ?= 1
MICROPY_VFS_LFS2 ?= 1

FROZEN_MANIFEST ?= $(BOARD_DIR)/manifest.py

# GC9A01 C driver (russhughes/gc9a01_mpy), via the symlink usermods/gc9a01 -> gc9a01_mpy/src
USER_C_MODULES ?= $(abspath $(BOARD_DIR)/../../usermods)

CFLAGS += -DMICROPY_ESP8266_2M
